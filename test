              <span className="text-xs font-semibold text-amber-700 bg-amber-50 ring-1 ring-amber-200 rounded-full px-3 py-1 shrink-0">
                {p.tag}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  Dashboard shell                                                    */
/* ------------------------------------------------------------------ */

function Dashboard() {
  const [activeTab, setActiveTab] = useState("progress");
  const [activeStage, setActiveStage] = useState("Payments");
  const [showPayments, setShowPayments] = useState(false);

  const handleStageSelect = (stage) => {
    setActiveStage(stage);
    if (stage === "Payments") {
      setShowPayments(true);
    } else {
      setShowPayments(false);
    }
  };

  const handleTabSelect = (tabKey) => {
    setActiveTab(tabKey);
    setShowPayments(false);
  };

  const handleOpenPayments = () => {
    setActiveStage("Payments");
    setShowPayments(true);
  };

  const renderTabContent = () => {
    if (showPayments) return <PaymentsDetailScreen onBack={() => setShowPayments(false)} />;
    switch (activeTab) {
      case "progress":
        return <YourProgressTab onOpenPayments={handleOpenPayments} />;
      case "boost":
        return <BoostProgressTab />;
      case "milestone":
        return <MilestoneTrackTab />;
      case "education":
        return <CreditEducationTab />;
      default:
        return null;
    }
  };

  return (
    <div className="min-h-screen bg-slate-50">
      {/* header */}
      <div className="bg-slate-900 text-white">
        <div className="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2.5">
            <div className="h-8 w-8 rounded-lg bg-teal-600 flex items-center justify-center font-bold text-sm">CR</div>
            <div>
              <p className="font-bold leading-tight">Credit Rebuild Program</p>
              <p className="text-xs text-slate-400 leading-tight">Account ending 4821</p>
            </div>
          </div>
          <div className="h-9 w-9 rounded-full bg-slate-700 flex items-center justify-center text-sm font-semibold">JD</div>
        </div>
        <StageBar activeStage={activeStage} onSelect={handleStageSelect} />
      </div>

      <div className="max-w-5xl mx-auto px-6 py-8">
        <div className="grid grid-cols-[220px_1fr] gap-8">
          {/* sidebar tabs */}
          <nav className="space-y-1 h-fit sticky top-8">
            {TABS.map((tab) => {
              const active = !showPayments && activeTab === tab.key;
              return (
                <button
                  key={tab.key}
                  onClick={() => handleTabSelect(tab.key)}
                  className={`w-full flex items-center gap-2.5 rounded-lg px-3.5 py-2.5 text-sm font-semibold transition-colors ${
                    active
                      ? "bg-teal-700 text-white shadow-sm"
                      : "text-slate-600 hover:bg-white hover:text-slate-900"
                  }`}
                >
                  <tab.icon size={16} />
                  {tab.label}
                </button>
              );
            })}
          </nav>

          {/* content */}
          <div>{renderTabContent()}</div>
        </div>
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  Root                                                               */
/* ------------------------------------------------------------------ */

export default function App() {
  const [screen, setScreen] = useState("search");

  if (screen === "search") {
    return <SearchScreen onSearch={() => setScreen("dashboard")} />;
  }
  return <Dashboard />;
}
