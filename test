function Field({ label, required, select, options, placeholder, trailingCheckbox, trailingButton }) {
  return (
    <label className="flex flex-col gap-1.5">
      <span className="text-xs font-medium text-slate-500">
        {required && <span className="text-rose-500 mr-0.5">*</span>}
        {label}
      </span>
      <div className="flex items-center gap-2">
        {select ? (
          <select className="w-full rounded-md border border-slate-300 text-sm px-3 py-2 text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
            {options.map((o) => (
              <option key={o}>{o}</option>
            ))}
          </select>
        ) : (
          <input
            type="text"
            placeholder={placeholder}
            className="w-full rounded-md border border-slate-300 text-sm px-3 py-2 text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
          />
        )}
        {trailingCheckbox && (
          <label className="flex items-center gap-1.5 text-xs text-slate-500 whitespace-nowrap">
            <input type="checkbox" className="rounded border-slate-300 text-teal-600 focus:ring-teal-500" />
            {trailingCheckbox}
          </label>
        )}
        {trailingButton && (
          <button className="whitespace-nowrap text-xs font-semibold text-white bg-teal-700 hover:bg-teal-800 rounded-md px-3 py-2 transition-colors">
            {trailingButton}
          </button>
        )}
      </div>
    </label>
  );
}

